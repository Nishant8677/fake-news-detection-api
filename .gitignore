# Virtual environments
.venv/
venv/
env/
__pycache__/
*.pyc

# Large artifacts — not committed
data/
model/
logs/
*.zip

# ONNX exports: 418 MB fp32 + 105 MB int8, regenerated by scripts/export_onnx.py
# in about 30 seconds. The measurements derived from them are committed in
# results/onnx_benchmark.json; the weights themselves have no more business here
# than model/ does. The summary is kept because it is small and describes the
# export rather than containing it.
model_onnx/*
!model_onnx/export_summary.json
*.pt
*.bin
*.pth
*.safetensors

# Evaluation evidence IS committed — see BENCHMARK.md
!results/
!plots/

# Tests
.pytest_cache/

# OS files
.DS_Store
